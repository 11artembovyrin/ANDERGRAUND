  m_text: "\u0414\u0430\u043B\u044C\u0448\u0435 \u0431\u0443\u0434\u0435\u0442 \u0432\u0440\u0430\u0433,
    \u0433\u043E\u0442\u043E\u0432\u044C\u0441\u044F. \u0415\u0441\u043B\u0438 \u0447\u0442\u043E
    \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0440\u044B\u0432\u043E\u043A \u043D\u0430 \u043B\u0435\u0432\u044B\u0439 \u0428\u0438\u0444\u0442.
